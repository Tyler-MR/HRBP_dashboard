# 复制本文件为 .env 并填入真实值（.env 已被 git 忽略，不会提交）
# 钉钉企业内部应用凭证 — 仅后端使用，不暴露给前端
DINGTALK_APP_KEY=你的钉钉AppKey
DINGTALK_APP_SECRET=你的钉钉AppSecret
DINGTALK_AGENT_ID=你的钉钉AgentId

# 钉钉多维表人效数据（仅后端使用）
DINGTALK_BITABLE_APP_KEY=你的多维表ClientKey
DINGTALK_BITABLE_APP_SECRET=你的多维表ClientSecret
DINGTALK_BITABLE_CORP_ID=你的CorpId
DINGTALK_BITABLE_BASE_ID=ZgpG2NdyVXKlg9pBUPyv1eMrWMwvDqPk
DINGTALK_BITABLE_SHEET_ID=HroRyqe
DINGTALK_BITABLE_TABLE_NAME=人事招聘源数据
DINGTALK_BITABLE_OPERATOR_UNION_ID=钉钉unionid（多维表operatorId）
DINGTALK_BITABLE_OPERATOR_USER_ID=钉钉userid（员工用户ID，仅作记录）

# 公司/部门人效数据源
DINGTALK_HR_EFFICIENCY_BASE_ID=R1zknDm0WRblLYgOIzyPMLXmWBQEx5rG
DINGTALK_HR_EFFICIENCY_DEPT_SHEET_ID=自动查找或填写sheetId
